# --- Postgres / PostGIS ---
POSTGRES_USER=evrouter
POSTGRES_PASSWORD=evrouter
POSTGRES_DB=evrouter
DATABASE_URL=postgresql://evrouter:evrouter@postgis:5432/evrouter

# --- Valhalla ---
# Small demo region by default (fast to build). Swap for a bigger Geofabrik
# extract (e.g. https://download.geofabrik.de/north-america/us/california-latest.osm.pbf)
# for real coverage. Full NA+Europe continental tiles need 32GB+ RAM and hours
# to build - not recommended for a first run.
VALHALLA_REGION_PBF_URL=https://download.geofabrik.de/north-america/us/colorado-latest.osm.pbf
VALHALLA_URL=http://valhalla:8002

# --- Photon ---
# Prebuilt per-country search indexes published by komoot, see infra/photon/README.md
PHOTON_COUNTRY_CODE=us
PHOTON_URL=http://photon:2322

# --- Pricing data providers ---
# NREL AFDC: free DEMO_KEY works for light use; get a real key at
# https://developer.nrel.gov/signup/ for production use.
NREL_API_KEY=DEMO_KEY
# Open Charge Map: no key required for read access, but a free key raises
# rate limits: https://openchargemap.org/site/loginprovider
OCM_API_KEY=
# EIA: required for US fuel price ingestion, free key at
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# --- API server ---
API_PORT=3001
CORS_ORIGIN=http://localhost:5173

# --- Web ---
VITE_API_BASE_URL=http://localhost:3001
